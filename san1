<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Portal Analityka Celnego</title>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: Arial, sans-serif;
    }

    body {
        background-color: #f4f6f9;
        color: #333;
    }

    header {
        background: #003366;
        color: white;
        padding: 20px;
        text-align: center;
    }

    nav {
        background: #0055a4;
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
    }

    nav a {
        color: white;
        text-decoration: none;
        padding: 15px 20px;
        transition: 0.3s;
    }

    nav a:hover {
        background: #003366;
    }

    .container {
        max-width: 1300px;
        margin: 20px auto;
        padding: 20px;
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(280px,1fr));
        gap: 20px;
    }

    .card {
        background: white;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0px 2px 8px rgba(0,0,0,0.1);
    }

    .card h3 {
        color: #003366;
        margin-bottom: 10px;
    }

    input, select {
        width: 100%;
        padding: 10px;
        margin-top: 10px;
        border: 1px solid #ccc;
        border-radius: 6px;
    }

    button {
        background: #0055a4;
        color: white;
        border: none;
        padding: 10px 15px;
        margin-top: 10px;
        border-radius: 6px;
        cursor: pointer;
    }

    button:hover {
        background: #003366;
    }

    .result {
        margin-top: 15px;
        padding: 10px;
        background: #eef5ff;
        border-radius: 6px;
    }

    footer {
        margin-top: 30px;
        background: #003366;
        color: white;
        text-align: center;
        padding: 15px;
    }

    .status {
        color: green;
        font-weight: bold;
    }
</style>
</head>

<body>

<header>
    <h1>Portal Analityka Celnego</h1>
    <p>TARIC • Sankcje • Antydumping • OSINT • Analiza Podmiotów</p>
</header>

<nav>
    <a href="#">Dashboard</a>
    <a href="#">TARIC</a>
    <a href="#">Sankcje</a>
    <a href="#">OSINT</a>
    <a href="#">Raporty</a>
</nav>

<div class="container">

<div class="grid">

<div class="card">
    <h3>Wyszukiwanie kodu CN/TARIC</h3>

    <input type="text" id="taric" placeholder="np. 39261000">

    <button onclick="szukajTaric()">
        Sprawdź
    </button>

    <div id="wynikTaric" class="result">
        Wprowadź kod.
    </div>
</div>

<div class="card">
    <h3>Analiza Podmiotu</h3>

    <input type="text" id="firma" placeholder="Nazwa firmy">

    <button onclick="analizujFirme()">
        Analizuj
    </button>

    <div id="wynikFirma" class="result">
        Oczekiwanie na dane.
    </div>
</div>

<div class="card">
    <h3>Kontrola Sankcyjna</h3>

    <input type="text" id="kraj" placeholder="Kraj">

    <button onclick="sprawdzSankcje()">
        Sprawdź
    </button>

    <div id="wynikSankcje" class="result">
        Brak danych.
    </div>
</div>

<div class="card">
    <h3>Cła Antydumpingowe</h3>

    <input type="text" id="kodAd" placeholder="Kod CN">

    <button onclick="sprawdzAD()">
        Weryfikuj
    </button>

    <div id="wynikAD" class="result">
        Brak danych.
    </div>
</div>

<div class="card">
    <h3>Statystyki Analiz</h3>

    <p>Wykonane analizy:</p>
    <h2 id="licznik">0</h2>
</div>

<div class="card">
    <h3>Status Integracji</h3>

    <ul>
        <li>ISZTAR API: <span class="status">Gotowe do podłączenia</span></li>
        <li>TARIC UE: <span class="status">Gotowe do podłączenia</span></li>
        <li>OpenSanctions: <span class="status">Gotowe do podłączenia</span></li>
        <li>KRS API: <span class="status">Gotowe do podłączenia</span></li>
    </ul>
</div>

</div>

</div>

<footer>
    Portal Analityka Celnego © 2026
</footer>

<script>

let licznik = 0;

function zwiekszLicznik() {
    licznik++;
    document.getElementById("licznik").innerText = licznik;
}

function szukajTaric() {

    let kod = document.getElementById("taric").value;

    document.getElementById("wynikTaric").innerHTML =
        "<b>Kod:</b> " + kod +
        "<br>Tu można podłączyć API ISZTAR lub TARIC.";

    zwiekszLicznik();
}

function analizujFirme() {

    let firma = document.getElementById("firma").value;

    document.getElementById("wynikFirma").innerHTML =
        "<b>Firma:</b> " + firma +
        "<br>Tu można podłączyć KRS, VIES, OpenCorporates lub własną bazę.";

    zwiekszLicznik();
}

function sprawdzSankcje() {

    let kraj = document.getElementById("kraj").value;

    document.getElementById("wynikSankcje").innerHTML =
        "<b>Kraj:</b> " + kraj +
        "<br>Tu można podłączyć OpenSanctions oraz listy UE.";

    zwiekszLicznik();
}

function sprawdzAD() {

    let kod = document.getElementById("kodAd").value;

    document.getElementById("wynikAD").innerHTML =
        "<b>Kod:</b> " + kod +
        "<br>Tu można sprawdzić środki antydumpingowe z TARIC.";

    zwiekszLicznik();
}

</script>

</body>
</html>
